# Application
APP_NAME=ForexNews AI
APP_VERSION=2.0.0
DEBUG=true
ENVIRONMENT=development

# API
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/forexnews
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=300

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# External APIs (Get your own keys - leave empty for demo mode)
ALPHA_VANTAGE_API_KEY=
NEWSAPI_KEY=
FINNHUB_API_KEY=
TWELVE_DATA_API_KEY=
OANDA_API_KEY=
OANDA_ACCOUNT_ID=
OANDA_ENVIRONMENT=practice

# News Sources
NEWS_SOURCES=https://www.forexfactory.com/ffcal_week_this.xml,https://www.investing.com/rss/news_285.rss,https://www.dailyfx.com/feeds/market_news,https://feeds.bloomberg.com/markets/news.rss,https://www.reuters.com/business/finance/rss,https://www.cnbc.com/id/10000113/device/rss/rss.html,https://www.marketwatch.com/rss/topstories,https://finance.yahoo.com/rss/topstories

# Forex Pairs
FOREX_PAIRS=EURUSD,GBPUSD,USDJPY,USDCHF,AUDUSD,USDCAD,NZDUSD,EURGBP,EURJPY,GBPJPY,AUDJPY,CADJPY,CHFJPY,EURAUD,EURCAD,EURCHF,GBPAUD,GBPCAD,GBPCHF,AUDCAD,AUDCHF,AUDNZD,CADCHF,NZDCAD,NZDCHF

# ML Model Settings
MODEL_PATH=/app/ml/models
SENTIMENT_MODEL=ProsusAI/finbert
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
PREDICTION_HORIZON_MINUTES=15,30,60,240,1440
CONFIDENCE_THRESHOLD=0.65
RETRAIN_INTERVAL_HOURS=24

# WebSocket
WS_HEARTBEAT_INTERVAL=30
WS_MAX_CONNECTIONS=1000

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Frontend
VITE_API_URL=http://localhost:8000/api/v1
VITE_WS_URL=ws://localhost:8000

# Flower (Celery Monitoring)
FLOWER_USER=admin
FLOWER_PASSWORD=admin123